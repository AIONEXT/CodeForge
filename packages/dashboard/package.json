{
  "name": "@codeforge/dashboard",
  "version": "1.0.0",
  "description": "Self-contained UI dashboard for CodeForge sessions, embeddable in VS Code webviews and JetBrains JCEF panels",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --watch --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.{ts,tsx}",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "codeforge",
    "dashboard",
    "session-recorder",
    "vscode-webview",
    "jcef"
  ],
  "license": "MIT"
}
