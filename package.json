{
  "name": "codeforge",
  "version": "0.1.0",
  "private": true,
  "description": "Universal command recorder and recall system for every coder",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:core": "pnpm --filter @codeforge/core build",
    "build:vscode": "pnpm --filter @codeforge/vscode build",
    "build:dashboard": "pnpm --filter @codeforge/dashboard build",
    "lint": "pnpm -r lint",
    "lint:core": "pnpm --filter @codeforge/core lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "clean": "pnpm -r exec rm -rf dist .turbo node_modules/.cache",
    "dev:core": "pnpm --filter @codeforge/core dev"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "overrides": {
      "typescript": "^5.7.0"
    }
  }
}
